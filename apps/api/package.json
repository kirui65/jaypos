{
  "name": "@eminent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=../../.env NODE_OPTIONS=--require=dotenv/config tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "DOTENV_CONFIG_PATH=../../.env NODE_OPTIONS=--require=dotenv/config prisma generate",
    "db:migrate": "DOTENV_CONFIG_PATH=../../.env NODE_OPTIONS=--require=dotenv/config prisma migrate deploy",
    "db:seed": "DOTENV_CONFIG_PATH=../../.env NODE_OPTIONS=--require=dotenv/config tsx prisma/seed.ts"
  },
  "dependencies": {
    "@eminent/shared": "workspace:*",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdfkit": "^0.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.3.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3"
  }
}
