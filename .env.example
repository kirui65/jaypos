# Local Docker PostgreSQL. For Supabase, use the transaction pooler for runtime
# queries in DATABASE_URL and the session pooler for Prisma migrations in DIRECT_URL.
DATABASE_URL=postgresql://eminent:eminent_dev@localhost:5432/eminent_jay?schema=public
DIRECT_URL=postgresql://eminent:eminent_dev@localhost:5432/eminent_jay?schema=public
# Supabase example formats (replace placeholders; URL-encode the password):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
ADMIN_SEED_EMAIL=owner@eminentjay.local
# If omitted, the seed script generates a one-time password and prints it to the terminal.
ADMIN_SEED_PASSWORD=
PAYMENT_PROVIDER=mock
LIPWA_API_KEY=
LIPWA_CHANNEL_ID=
LIPWA_CALLBACK_URL=
# Optional override; Lipwa's documented production API host is https://pay.lipwa.app.
LIPWA_BASE_URL=https://pay.lipwa.app
